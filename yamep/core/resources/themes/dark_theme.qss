/* Dark Theme - Base: Deep Gray with Blue Accents */
QWidget {
    background-color: #2D2D2D;
    color: #E0E0E0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #2D2D2D;
}

QTextEdit, QTextBrowser {
    background-color: #3A3A3A;
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    border-radius: 4px;
    padding: 8px;
}

QToolBar {
    background-color: #363636;
    border-bottom: 1px solid #4A4A4A;
    spacing: 5px;
    padding: 4px;
}

QToolButton {
    background-color: #4A4A4A;
    color: #E0E0E0;
    border: 1px solid #5A5A5A;
    border-radius: 4px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #5A5A5A;
    border-color: #4A90E2;
}

QComboBox, QTreeWidget {
    background-color: #3A3A3A;
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    border-radius: 4px;
    padding: 4px;
}

QTabWidget::pane {
    border: 1px solid #4A4A4A;
}

QMessageBox {
    background-color: #3A3A3A;
}

QMessageBox QLabel {
    color: #FFFFFF;
}