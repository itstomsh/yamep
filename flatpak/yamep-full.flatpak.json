{
  "id": "io.github.itstomsh.yamep",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.PySide.BaseApp",
  "base-version": "6.11",
  "command": "yamep",
  "finish-args": [
    "--filesystem=home",
    "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess",
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    "pypi-deps.json",
    {
      "name": "python3-pygments",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} pygments==2.21.0 --no-build-isolation"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/71/46/17f022dd3e953bf20a04a028a21ec746d942f8d2af30fa0f124fa0e6a684/pygments-2.21.0-py3-none-any.whl",
          "sha256": "2363c69b61c4a97c838da3b130dcd6468f4848992b21a82f2a63ec34377137d9"
        }
      ]
    },
    {
      "name": "desktop-entry",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 io.github.itstomsh.yamep.desktop /app/share/applications/io.github.itstomsh.yamep.desktop",
        "install -Dm644 io.github.itstomsh.yamep.png /app/share/icons/hicolor/128x128/apps/io.github.itstomsh.yamep.png",
        "install -Dm644 io.github.itstomsh.yamep.metainfo.xml /app/share/metainfo/io.github.itstomsh.yamep.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "io.github.itstomsh.yamep.desktop"
        },
        {
          "type": "file",
          "path": "io.github.itstomsh.yamep.png"
        },
        {
          "type": "file",
          "path": "io.github.itstomsh.yamep.metainfo.xml"
        }
      ]
    },
    {
      "name": "yamep",
      "buildsystem": "simple",
      "build-commands": [
        "cp pyproject-full.toml pyproject.toml",
        "pip3 install --no-build-isolation --prefix=/app ."
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../",
          "skip": [
            ".flatpak-build",
            ".flatpak-builder",
            ".git",
            "build",
            "build-dir",
            "dist",
            "flatpak",
            "flatpak-build-dir",
            "venv",
            "yamep-full.flatpak",
            "yamep-lite.flatpak",
            "yamep-repo",
            "yamep.egg-info",
            "yamep_lite.egg-info"
          ]
        }
      ]
    }
  ],
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh",
    "rm -rfv /app/lib/libLLVM.so* /app/lib/libclang*.so* /app/lib/python3.*/site-packages/shiboken6_generator"
  ],
  "build-options": {
    "env": {
      "BASEAPP_DISABLE_NUMPY": "1"
    }
  }
}
